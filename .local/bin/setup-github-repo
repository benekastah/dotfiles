#!/bin/bash
# Set up a GitHub repository the way I like it:
#
# - squash merges only, the squash commit taking the PR's title (or its one
#   commit's) and its commits' messages; merged branches deleted; auto-merge
#   allowed, so `gh pr merge --squash --auto` merges once CI passes;
# - secret scanning with push protection, Dependabot alerts, and Dependabot
#   security updates;
# - a ruleset, "main", requiring the "CI passed" check on the default branch,
#   if GitHub Actions has run a check by that name on one of the default
#   branch's last 10 commits (so CI must run on pushes to it) (a required check that never runs would block
#   every merge; for a new repository, run this again once CI has run).
#
# On a private repository, it skips what GitHub's plan doesn't offer there:
# secret scanning (it needs GitHub Advanced Security), and auto-merge and the
# ruleset if GitHub refuses them (on a free plan); it says what it skipped.
#
# Usage: setup-github-repo [-c CHECK] [OWNER/REPO]
#
#   OWNER/REPO  the repository (default: the current directory's, through gh)
#   -c CHECK    the check to require (default: "CI passed")
#
# It sets each thing to a state rather than toggling it, so running it again
# changes nothing. Needs gh, logged in as someone who administers the
# repository, and jq.
set -euo pipefail

# This file's first comment, without its "# ".
usage() {
    awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
}

check="CI passed"
while getopts c:h opt; do
    case $opt in
        c) check=$OPTARG ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
done
shift $((OPTIND - 1))
if [ $# -gt 1 ]; then
    usage >&2
    exit 2
fi
repo=${1:-$(gh repo view --json nameWithOwner --jq .nameWithOwner)}
echo "setting up $repo"
private=$(gh api "repos/$repo" --jq .private)

# GitHub ignores allow_auto_merge where the plan doesn't offer it, so report
# what it set.
auto_merge=$(gh api -X PATCH "repos/$repo" \
    -F allow_squash_merge=true \
    -F allow_merge_commit=false \
    -F allow_rebase_merge=false \
    -f squash_merge_commit_title=COMMIT_OR_PR_TITLE \
    -f squash_merge_commit_message=COMMIT_MESSAGES \
    -F delete_branch_on_merge=true \
    -F allow_auto_merge=true \
    --jq .allow_auto_merge)
if $auto_merge; then
    echo "  merging: squash only, merged branches deleted, auto-merge allowed"
else
    echo "  merging: squash only, merged branches deleted; auto-merge skipped (GitHub's plan doesn't offer it here)"
fi

if $private; then
    echo "  secret scanning: skipped (a private repository needs GitHub Advanced Security for it)"
else
    gh api --silent -X PATCH "repos/$repo" --input - <<'EOF'
{"security_and_analysis": {
    "secret_scanning": {"status": "enabled"},
    "secret_scanning_push_protection": {"status": "enabled"}}}
EOF
    echo "  secret scanning: on, with push protection"
fi
gh api --silent -X PUT "repos/$repo/vulnerability-alerts"
gh api --silent -X PUT "repos/$repo/automated-security-fixes"
echo "  dependabot: alerts and security updates on"

# Runs `gh api` with the given arguments, printing its output. When it fails
# with a message matching the extended regular expression $1 (gh's, which ends
# with "(HTTP <status>)"), it prints nothing and returns 2; any other failure
# prints gh's message and returns 1.
api_unless() {
    local expected=$1 out
    shift
    if out=$(gh api "$@" 2>&1); then
        printf '%s\n' "$out"
    elif grep -Eq "$expected" <<<"$out"; then
        return 2
    else
        printf '%s\n' "$out" >&2
        return 1
    fi
}

# Whether GitHub Actions has run the check on one of the default branch's last
# 10 commits (not just the latest, whose CI may still be queued). This needs
# CI that runs on pushes to the default branch, not only on pull requests. An
# empty repository (409) has no commits.
branch=$(gh api "repos/$repo" --jq .default_branch)
if commits=$(api_unless '\(HTTP 409\)$' -X GET "repos/$repo/commits" -f sha="$branch" \
    -F per_page=10 --jq '.[].sha'); then
    :
else
    [ $? = 2 ] || exit 1
    commits=
fi
has_check=false
for sha in $commits; do
    runs=$(gh api -X GET "repos/$repo/commits/$sha/check-runs" \
        -f check_name="$check" -F app_id=15368 --jq .total_count)
    if [ "$runs" != 0 ]; then
        has_check=true
        break
    fi
done
if ! $has_check; then
    echo "  required checks: unchanged (no \"$check\" check has run on $branch's last 10 commits)"
    exit 0
fi
ruleset=$(jq -n --arg check "$check" '{
    name: "main",
    target: "branch",
    enforcement: "active",
    bypass_actors: [],
    conditions: {ref_name: {include: ["~DEFAULT_BRANCH"], exclude: []}},
    rules: [{type: "required_status_checks", parameters: {
        do_not_enforce_on_create: false,
        strict_required_status_checks_policy: false,
        required_status_checks: [{context: $check, integration_id: 15368}]}}]}')
# 15368 is GitHub Actions: only its check of that name counts.
# The repository's own rulesets, not an organization's. GitHub refuses rulesets
# on a private repository on a free plan, with a 403 asking to upgrade; any
# other 403 (no admin rights, a rate limit) is an error.
if id=$(api_unless '^gh: Upgrade to GitHub.*\(HTTP 403\)$' "repos/$repo/rulesets?includes_parents=false" \
    --jq '.[] | select(.name == "main") | .id'); then
    :
else
    [ $? = 2 ] || exit 1
    echo "  required checks: skipped (GitHub's plan doesn't offer rulesets here)"
    exit 0
fi
if [ -n "$id" ]; then
    gh api --silent -X PUT "repos/$repo/rulesets/$id" --input - <<<"$ruleset"
else
    gh api --silent -X POST "repos/$repo/rulesets" --input - <<<"$ruleset"
fi
echo "  required checks: \"$check\" on $branch (ruleset \"main\")"
