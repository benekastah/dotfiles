#!/bin/bash
# Link shared skills into the directories read by Codex and Claude Code.
set -eu

source_dir="$HOME/.config/agents/skills"
if [[ ! -d "$source_dir" ]]; then
    echo "Skills directory not found: $source_dir" >&2
    exit 1
fi

codex_dir="$HOME/.agents/skills"
claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills"
mkdir -p "$codex_dir" "$claude_dir"
status=0
for skill in "$source_dir"/*; do
    [[ -d "$skill" && -f "$skill/SKILL.md" ]] || continue
    name=${skill##*/}
    for destination in "$codex_dir/$name" "$claude_dir/$name"; do
        if [[ -L "$destination" && "$destination" -ef "$skill" ]]; then
            continue
        elif [[ -e "$destination" || -L "$destination" ]]; then
            echo "Already exists, left unchanged: $destination" >&2
            status=1
        elif ln -s "$skill" "$destination"; then
            echo "Linked $destination"
        else
            status=1
        fi
    done
done
exit "$status"
