[Desktop Entry]
Encoding=UTF-8
Type=Application
Name=REAPER
Comment=REAPER
Categories=Audio;Video;AudioVideo;AudioVideoEditing;Recorder;
Exec=pw-jack aj-snapshot -d ~/a2j-connections.xml & PIPEWIRE_QUANTUM=128/48000 pw-jack "/usr/lib/REAPER/reaper" %F
Icon=cockos-reaper
MimeType=application/x-reaper-project;application/x-reaper-project-backup;application/x-reaper-theme
StartupWMClass=REAPER
